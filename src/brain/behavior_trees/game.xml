<!-- 正式比赛专用, 严格执行规则, 无法人工接管 -->

<root BTCPP_format="4">
    <include path="./subtrees/subtree_cam_find_and_track_ball.xml" />
    <include path="./subtrees/subtree_find_ball_setplay.xml" />
    <include path="./subtrees/subtree_striker_play.xml" />
    <include path="./subtrees/subtree_goal_keeper_play.xml" />
    <include path="./subtrees/subtree_striker_freekick.xml" />
    <include path="./subtrees/subtree_goal_keeper_freekick.xml" />
    <include path="./subtrees/subtree_goal_keeper_penalty_kick.xml" />
    <include path="./subtrees/subtree_normal_play.xml" />
    <include path="./subtrees/subtree_kickoff_play.xml" />
    <include path="./subtrees/subtree_direct_free_kick.xml" />
    <include path="./subtrees/subtree_indirect_free_kick.xml" />
    <include path="./subtrees/subtree_corner_kick.xml" />
    <include path="./subtrees/subtree_goal_kick.xml" />
    <include path="./subtrees/subtree_throw_in.xml" />
    <include path="./subtrees/subtree_penalty_kick.xml" />
    <include path="./subtrees/subtree_unknown_set_play.xml" />
    <include path="./subtrees/subtree_locate.xml" />
    <include path="./subtrees/subtree_auto_standup_and_locate.xml" />
    <BehaviorTree ID="MainTree">
        <Sequence name="root">
            <!-- <RunOnce><RobocupWalk /></RunOnce> -->
            <RunOnce><Script code="control_state=3" /></RunOnce>
            <ReactiveSequence _while="control_state==1 || assist_kick || go_manual || assist_chase" >
                <Speak text="manual" />
                <!-- <SubTree ID="CamFindAndTrackBall" _autoremap="true" /> -->
                <SimpleChase _while="assist_chase" vx_limit="1.5" vy_limit="0.1" stop_dist="0.0" stop_angle="0.3" />
                <Sequence _while="assist_kick">
                    <!-- <StepOnSpot /> -->
                    <Kick speed_limit="0.9" min_msec_kick="1000"/>
               </Sequence>
            </ReactiveSequence>

            <ReactiveSequence _while="control_state==2" name="需要 pickup 时， 先走到进场位置， 然后按下 LT + A, 重新校准定位, 等待数秒后, 按 LT + B 继续比赛">
                <RunOnce><RobocupWalk /></RunOnce>
                <Speak text="locate" />
                <CamScanField _while="!odom_calibrated" />
                <SubTree ID="CamFindAndTrackBall" _autoremap="true" _while="odom_calibrated" />
                <SelfLocateEnterField />

            </ReactiveSequence>

            <ReactiveSequence _while="control_state==3 &amp;&amp; (!go_manual)" name="包一层用于控制策略的开关, 3 为手柄 LT+B 的状态, 2 为 LT+A, 1 为 LT+X">
                <Speak text="auto" />
                <ReactiveSequence _while="gc_play_stopped" name="StopPlay 时无条件停止运动">
                    <SetVelocity />
                </ReactiveSequence>

                <ReactiveSequence _while="!gc_play_stopped" name="StopPlay 解除后才执行比赛策略">
                    <SubTree ID="AutoGetUpAndLocate" _autoremap="true" />
                    <ReactiveSequence _while="gc_is_under_penalty" name="当前处于罚时状态, 或替补状态">
                        <SetVelocity />
                        <CamScanField _while="!odom_calibrated" />
                        <SubTree ID="CamFindAndTrackBall" _autoremap="true" _while="odom_calibrated" />
                        <SelfLocateEnterField />
                    </ReactiveSequence>

                    <ReactiveSequence _while="!gc_is_under_penalty" name="没有罚时, 正常比赛">
                    <ReactiveSequence _while="gc_game_sub_state_type=='TIMEOUT'" name="比赛暂停. 暂停时, game state 必为 INITIAL">
                        <SetVelocity />
                        <!-- <PrintMsg msg="Timeout. Calibrating..." /> -->
                        <SubTree ID="CamFindAndTrackBall" _autoremap="true" _while="odom_calibrated" />
                    </ReactiveSequence>

                    <ReactiveSequence _while="gc_game_sub_state_type=='NONE' &amp;&amp; !penalty_kick_active" name="正常比赛">
                        <ReactiveSequence _while="gc_game_state=='INITIAL'" name="在场外入场位置站好">
                            <CamScanField _while="!odom_calibrated"/>
                            <SubTree ID="CamFindAndTrackBall" _autoremap="true" _while="odom_calibrated" />
                            <SelfLocateEnterField />
                        </ReactiveSequence>

                        <ReactiveSequence _while="gc_game_state=='READY'" name="走到场内自己的起始位置">
                            <MoveHead pitch="0.35" yaw="0.0" />
                            <GoToReadyPosition  vx_limit="0.7" dist_tolerance="0.6" theta_tolerance="0.2" />
                            <SubTree ID="Locate" _autoremap="true" />
                            <!-- <WaveHand _while="we_just_scored" action="start" /> -->
                        </ReactiveSequence>

                        <ReactiveSequence _while="gc_game_state=='SET'" name="站好等待比赛开始">
                            <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
                            <SetVelocity />
                            <SubTree ID="Locate" _autoremap="true" />
                            <!-- <WaveHand action="stop" /> -->
                        </ReactiveSequence>

                        <ReactiveSequence _while="gc_game_state=='PLAY'" name="比赛">
                            <!-- 我方角球在 v20 恢复比赛后会被映射为 NONE/PLAY，必须在 PLAY 内单独接入。 -->
                            <SubTree ID="CornerKick" _autoremap="true"
                                _while="gc_real_game_sub_state=='CORNER_KICK' &amp;&amp; gc_is_sub_state_kickoff_side &amp;&amp; setplay_pair_ready &amp;&amp; !setplay_kick_done" />
                            <SubTree ID="GoalKick" _autoremap="true"
                                _while="gc_real_game_sub_state=='GOAL_KICK' &amp;&amp; gc_is_sub_state_kickoff_side &amp;&amp; setplay_pair_ready &amp;&amp; !setplay_kick_done" />
                            <SubTree ID="ThrowIn" _autoremap="true"
                                _while="gc_real_game_sub_state=='THROW_IN' &amp;&amp; gc_is_sub_state_kickoff_side &amp;&amp; setplay_pair_ready &amp;&amp; !setplay_kick_done" />
                            <SubTree ID="KickoffPlay" _autoremap="true"
                                _while="gc_kickoff_active &amp;&amp; (gc_real_game_sub_state=='NONE' || gc_real_game_sub_state=='OVERTIME')" />
                            <SubTree ID="NormalPlay" _autoremap="true"
                                _while="!gc_kickoff_active &amp;&amp; (gc_real_game_sub_state=='NONE' || gc_real_game_sub_state=='OVERTIME' || (!setplay_pair_ready &amp;&amp; (gc_real_game_sub_state=='CORNER_KICK' || gc_real_game_sub_state=='GOAL_KICK' || gc_real_game_sub_state=='THROW_IN')))" />
                        </ReactiveSequence>

                        <ReactiveSequence _while="gc_game_state=='END'" name="比赛结束">
                            <SetVelocity />
                        </ReactiveSequence>

                    </ReactiveSequence>

                    <ReactiveSequence _while="penalty_kick_active &amp;&amp; gc_game_state=='PLAY'" name="点球策略">
                        <SubTree ID="PenaltyKick" _autoremap="true" />
                    </ReactiveSequence>

                    <ReactiveSequence _while="gc_game_sub_state_type=='FREE_KICK' &amp;&amp; gc_game_state=='PLAY' &amp;&amp; !penalty_kick_active" name="开任意球">
                        <SubTree ID="DirectFreeKick" _autoremap="true"
                            _while="gc_real_game_sub_state=='DIRECT_FREEKICK'" />
                        <SubTree ID="IndirectFreeKick" _autoremap="true"
                            _while="gc_real_game_sub_state=='INDIRECT_FREEKICK'" />
                        <SubTree ID="CornerKick" _autoremap="true"
                            _while="gc_real_game_sub_state=='CORNER_KICK' &amp;&amp; (!gc_is_sub_state_kickoff_side || setplay_pair_ready)" />
                        <SubTree ID="GoalKick" _autoremap="true"
                            _while="gc_real_game_sub_state=='GOAL_KICK' &amp;&amp; (!gc_is_sub_state_kickoff_side || setplay_pair_ready)" />
                        <SubTree ID="ThrowIn" _autoremap="true"
                            _while="gc_real_game_sub_state=='THROW_IN' &amp;&amp; (!gc_is_sub_state_kickoff_side || setplay_pair_ready)" />
                        <SubTree ID="UnknownSetPlay" _autoremap="true"
                            _while="gc_real_game_sub_state=='UNKNOWN_SET_PLAY'" />
                    </ReactiveSequence>

                    </ReactiveSequence>
                </ReactiveSequence>
            </ReactiveSequence>
        </Sequence>
    </BehaviorTree>
</root>
