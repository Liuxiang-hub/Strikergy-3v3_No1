<root BTCPP_format="4">
  <BehaviorTree ID="FindBall">
    <Sequence name="root">
      <GoBackInField />

      <!-- 同一持续节点：前约 2.1 秒仅扫头，随后扫头并旋转身体一周。 -->
      <ReactiveSequence _while="!(ball_location_known || tm_ball_pos_reliable)">
        <CamFastScan rad="6.283185307" vyaw_limit="0.8" />
      </ReactiveSequence>

      <!-- 一周后仍无球：按编号导航到分区搜索点，移动中继续扫头。 -->
      <ReactiveSequence _while="!(ball_location_known || tm_ball_pos_reliable)">
        <CamFindBall />
        <MoveToBallSearchPosition />
      </ReactiveSequence>

      <!-- 到达搜索点后，持续扫头并原地旋转。 -->
      <ReactiveSequence _while="!(ball_location_known || tm_ball_pos_reliable)">
        <CamFindBall />
        <RobotFindBall vyaw_limit="0.8" />
      </ReactiveSequence>
    </Sequence>
  </BehaviorTree>
</root>
