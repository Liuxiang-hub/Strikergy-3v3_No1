<root BTCPP_format="4">
    <BehaviorTree ID="CornerKick">
        <ReactiveSequence>
            <ReactiveSequence _while="gc_real_game_sub_state=='CORNER_KICK' &amp;&amp; gc_is_sub_state_kickoff_side &amp;&amp; gc_game_state=='PLAY' &amp;&amp; !corner_kick_done">
                <CalcKickDir />
                <GoToFreekickPosition _while="player_role == 'striker' || player_role == 'supporter'" side="attack" vx_limit="0.7" vy_limit="0.5" />
                <Kick _while="corner_is_attacker &amp;&amp; corner_support_ready" speed_limit="1.4" min_msec_kick="1200" msecs_stablize="300" />
            </ReactiveSequence>
            <ReactiveSequence _while="gc_game_sub_state_type=='FREE_KICK' &amp;&amp; gc_game_sub_state=='GET_READY'">
                <SubTree ID="Locate" _autoremap="true" _while="ball_location_known" />
                <SubTree ID="StrikerFreekick" _autoremap="true"
                    _while="player_role == 'striker' || player_role == 'supporter'" />
                <SubTree ID="GoalKeeperFreekick" _autoremap="true"
                    _while="player_role == 'keeper'" />
            </ReactiveSequence>
            <SetVelocity _while="gc_game_sub_state_type=='FREE_KICK' &amp;&amp; (gc_game_sub_state=='STOP' || gc_game_sub_state=='SET')" />
            <ReactiveSequence _while="gc_game_sub_state_type=='NONE'">
                <SubTree ID="StrikerPlay" _autoremap="true"
                    _while="player_role == 'striker' || player_role == 'supporter'" />
                <SubTree ID="GoalKeeperPlay" _autoremap="true"
                    _while="player_role == 'keeper'" />
            </ReactiveSequence>
        </ReactiveSequence>
    </BehaviorTree>
</root>
