<root BTCPP_format="4">
    <BehaviorTree ID="CornerKick">
        <ReactiveSequence>
            <CornerPassState />
            <ReactiveSequence _while="gc_game_sub_state_type=='FREE_KICK' &amp;&amp; gc_game_sub_state=='GET_READY'">
                <SubTree ID="Locate" _autoremap="true" _while="ball_location_known" />
                <CalcKickDir _while="corner_pass_phase==1" />
                <MoveToPoseOnField x="0" y="0" theta="0" vx_limit="1.0" vy_limit="0.5"
                    _while="corner_pass_phase==1 &amp;&amp; player_role=='striker'" />
                <GoToFreekickPosition side="attack" vx_limit="0.7" vy_limit="0.4"
                    _while="corner_pass_phase==1 &amp;&amp; player_role=='supporter'" />
                <SubTree ID="StrikerFreekick" _autoremap="true"
                    _while="corner_pass_phase==0 &amp;&amp; (player_role == 'striker' || player_role == 'supporter')" />
                <SubTree ID="GoalKeeperFreekick" _autoremap="true"
                    _while="player_role == 'keeper'" />
            </ReactiveSequence>
            <SetVelocity _while="gc_game_sub_state_type=='FREE_KICK' &amp;&amp; (gc_game_sub_state=='STOP' || gc_game_sub_state=='SET')" />
            <ReactiveSequence _while="gc_game_sub_state_type=='NONE'">
                <CamTrackBall _while="ball_location_known" />
                <CalcKickDir _while="corner_pass_phase!=0" />
                <MoveToPoseOnField x="0" y="0" theta="0" vx_limit="1.0" vy_limit="0.5"
                    _while="player_role=='striker' &amp;&amp; (corner_pass_phase==1 || (corner_pass_phase==2 &amp;&amp; !corner_ball_near_receiver))" />
                <GoToFreekickPosition side="attack" vx_limit="0.7" vy_limit="0.4"
                    _while="corner_pass_phase==1 &amp;&amp; player_role=='supporter' &amp;&amp; !corner_receiver_ready" />
                <SubTree ID="StrikerPlay" _autoremap="true"
                    _while="(corner_pass_phase==0 &amp;&amp; (player_role=='striker' || player_role=='supporter')) || (corner_pass_phase==1 &amp;&amp; player_role=='supporter' &amp;&amp; corner_receiver_ready) || (corner_pass_phase==2 &amp;&amp; player_role=='striker' &amp;&amp; corner_ball_near_receiver)" />
                <Assist _while="corner_pass_phase==2 &amp;&amp; player_role=='supporter'" />
                <SubTree ID="GoalKeeperPlay" _autoremap="true"
                    _while="player_role == 'keeper'" />
            </ReactiveSequence>
        </ReactiveSequence>
    </BehaviorTree>
</root>
