<root BTCPP_format="4">
    <BehaviorTree ID="CornerKick">
        <ReactiveSequence>
            <ReactiveSequence _while="gc_real_game_sub_state=='CORNER_KICK' &amp;&amp; gc_game_state=='PLAY' &amp;&amp; player_role=='keeper'">
                <GoalieIdleHome dist_to_goalline="1.0" vx_limit="0.7" vy_limit="0.5"
                    pos_tolerance="0.45" theta_tolerance="0.40" />
            </ReactiveSequence>
            <ReactiveSequence _while="gc_real_game_sub_state=='CORNER_KICK' &amp;&amp; gc_is_sub_state_kickoff_side &amp;&amp; gc_game_state=='PLAY'">
                <!-- 等待和进攻必须互斥；进攻开始后不再重跑站位节点，避免中断 VisualKick。 -->
                <ReactiveSequence _while="!setplay_attack_active">
                    <SubTree ID="FindBall" _autoremap="true"
                        _while="!(ball_location_known || tm_ball_pos_reliable)" />
                    <CalcKickDir />
                    <GoToFreekickPosition _while="player_role == 'striker' || player_role == 'supporter'" side="attack" vx_limit="0.7" vy_limit="0.5" />
                </ReactiveSequence>
                <SubTree ID="StrikerPlay" _autoremap="true"
                    _while="setplay_is_attacker &amp;&amp; setplay_attack_active" />
            </ReactiveSequence>
            <ReactiveSequence _while="gc_game_sub_state_type=='FREE_KICK' &amp;&amp; gc_game_sub_state=='GET_READY'">
                <!-- 我方/对方角球在进入后续站位策略前，先确保至少获得视觉或队友球位。 -->
                <SubTree ID="FindBall" _autoremap="true"
                    _while="!(ball_location_known || tm_ball_pos_reliable)" />
                <SubTree ID="Locate" _autoremap="true" _while="ball_location_known" />
                <SubTree ID="StrikerFreekick" _autoremap="true"
                    _while="player_role == 'striker' || player_role == 'supporter'" />
                <GoalieIdleHome _while="player_role == 'keeper'" dist_to_goalline="1.0" vx_limit="0.7" vy_limit="0.5"
                    pos_tolerance="0.45" theta_tolerance="0.40" />
            </ReactiveSequence>
            <SetVelocity _while="gc_game_sub_state_type=='FREE_KICK' &amp;&amp; (gc_game_sub_state=='STOP' || gc_game_sub_state=='SET')" />
            <ReactiveSequence _while="gc_game_sub_state_type=='NONE'">
                <SubTree ID="StrikerPlay" _autoremap="true"
                    _while="player_role == 'striker' || player_role == 'supporter'" />
                <SubTree ID="GoalKeeperPlay" _autoremap="true"
                    _while="player_role == 'keeper'" />
            </ReactiveSequence>
        </ReactiveSequence>
    </BehaviorTree>
</root>
