<root BTCPP_format="4">
    <BehaviorTree ID="DirectFreeKick">
        <ReactiveSequence>
            <ReactiveSequence _while="gc_real_game_sub_state=='DIRECT_FREEKICK' &amp;&amp; gc_game_state=='PLAY' &amp;&amp; player_role=='keeper'">
                <SetVelocity />
            </ReactiveSequence>
            <ReactiveSequence _while="gc_real_game_sub_state=='DIRECT_FREEKICK' &amp;&amp; gc_is_sub_state_kickoff_side &amp;&amp; gc_game_state=='PLAY' &amp;&amp; gc_game_sub_state=='PLAY' &amp;&amp; (player_role=='striker' || player_role=='supporter')">
                <ReactiveSequence _while="!setplay_attack_active">
                    <SubTree ID="SetPlayFindBall" _autoremap="true"
                        _while="!(ball_location_known || tm_ball_pos_reliable)" />
                    <GoToFreekickPosition side="attack" vx_limit="0.7" vy_limit="0.5" />
                </ReactiveSequence>
                <SubTree ID="StrikerPlay" _autoremap="true"
                    _while="setplay_is_attacker &amp;&amp; setplay_attack_active" />
            </ReactiveSequence>
            <ReactiveSequence _while="gc_game_sub_state_type=='FREE_KICK' &amp;&amp; gc_game_sub_state=='GET_READY' &amp;&amp; (player_role=='striker' || player_role=='supporter')">
                <SubTree ID="FindBall" _autoremap="true"
                    _while="!(ball_location_known || tm_ball_pos_reliable)" />
                <SubTree ID="Locate" _autoremap="true" _while="ball_location_known" />
                <SubTree ID="StrikerFreekick" _autoremap="true"
                    _while="player_role == 'striker' || player_role == 'supporter'" />
            </ReactiveSequence>
            <SetVelocity _while="gc_game_sub_state_type=='FREE_KICK' &amp;&amp; (gc_game_sub_state=='STOP' || gc_game_sub_state=='SET')" />
            <ReactiveSequence _while="gc_game_sub_state_type=='NONE' &amp;&amp; gc_real_game_sub_state=='NONE'">
                <SubTree ID="StrikerPlay" _autoremap="true"
                    _while="player_role == 'striker' || player_role == 'supporter'" />
                <SubTree ID="GoalKeeperPlay" _autoremap="true"
                    _while="player_role == 'keeper'" />
            </ReactiveSequence>
        </ReactiveSequence>
    </BehaviorTree>
</root>
