<root BTCPP_format="4">
  <BehaviorTree ID="SetPlayFindBall">
    <Sequence name="set_play_find_ball">
      <GoBackInField />

      <!-- 同一持续节点：前约 2.1 秒仅扫头，随后扫头并旋转身体一周。 -->
      <ReactiveSequence _while="!(ball_location_known || tm_ball_pos_reliable)">
        <CamFastScan rad="6.283185307" vyaw_limit="0.8" />
      </ReactiveSequence>

      <!-- 定位球专用搜索点：1号 (-3,+3)，2号 (-3,-3)。 -->
      <ReactiveSequence _while="!(ball_location_known || tm_ball_pos_reliable)">
        <CamFindBall />
        <MoveToBallSearchPosition mode="set_play" />
      </ReactiveSequence>

      <!-- 到达专用点后继续扫头并原地旋转。 -->
      <ReactiveSequence _while="!(ball_location_known || tm_ball_pos_reliable)">
        <CamFindBall />
        <RobotFindBall vyaw_limit="0.8" />
      </ReactiveSequence>
    </Sequence>
  </BehaviorTree>
</root>
